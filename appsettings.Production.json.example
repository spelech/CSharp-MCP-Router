{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextGateway": "Information"
    }
  },
  "MCG_DATABASE_PROVIDER": "sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/mcg.db"
  },
  "MCG_MASTER_KEY": "YourSuperSecureHighEntropyBase64EncodedKeyHere==",
  "MCG_CORS_ALLOWED_ORIGINS": "https://mcg-dashboard.enterprise.com",
  "OpenIddict": {
    "CertificatePath": "/app/certs/oauth_signing.pfx",
    "CertificatePassword": "MySecretCertPassword123!"
  },
  "Admin": {
    "GroupSid": "S-1-5-32-544",
    "GroupName": "Domain Admins",
    "Groups": [
      "Domain Admins",
      "full_admin",
      "Administrators"
    ],
    "StandaloneAllowedNetworks": [
      "127.0.0.1",
      "::1",
      "10.0.0.0/8"
    ]
  },
  "Oidc": {
    "TrustedProxies": "10.0.5.10,172.17.0.1",
    "RequireTrustedProxy": true
  },
  "Identity": {
    "HeaderAuth": {
      "UserHeaders": [
        "Remote-User",
        "X-Forwarded-User"
      ],
      "GroupHeaders": [
        "Remote-Groups",
        "X-Forwarded-Groups",
        "sso_groups"
      ]
    }
  }
}