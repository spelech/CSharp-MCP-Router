# ==============================================================================
# C# MCP Router Gateway - Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Cryptographic Secrets (REQUIRED)
# ------------------------------------------------------------------------------
# 256-bit cryptographically secure Base64 master key used for database encryption
# and token signing. Generate using:
#   Linux/macOS: openssl rand -base64 32
#   PowerShell:  $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
ROUTER_MASTER_KEY=REPLACE_WITH_GENERATED_BASE64_256BIT_KEY

# ------------------------------------------------------------------------------
# 2. Database Provider & Connection Configuration
# ------------------------------------------------------------------------------
# Supported database providers:
#   - sqlite   (Default: embedded SQLite database in ./data/mcp_router.db)
#   - mssql    (Microsoft SQL Server 2019/2022)
#   - mysql    (MySQL 8.0+ / MariaDB)
#   - postgres (PostgreSQL)
DB_PROVIDER=sqlite

# Connection string (Required if DB_PROVIDER is mssql, mysql, or postgres):
# SQLite default: Data Source=data/mcp_router.db
# MSSQL example: Server=sql.domain.local,1433;Database=McpRouter;User Id=sa;Password=YourPassword;TrustServerCertificate=True;
# MySQL example: Server=db.domain.local;Port=3306;Database=mcp_router;User=mcp_user;Password=YourPassword;
# ConnectionStrings__DefaultConnection=Data Source=data/mcp_router.db

# ------------------------------------------------------------------------------
# 3. CORS & Web Dashboard Access
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for the web dashboard and LLM clients
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Admin Network Access Restrictions (Standalone Mode)
# ------------------------------------------------------------------------------
# Primary network or IP address allowed to access Admin Web UI & /admin endpoints.
# Defaults:
#   - 127.0.0.1  (Local loopback only)
#   - 10.0.0.0/8 (Private LAN CIDR subnet)
#   - 0.0.0.0/0  (Allow all networks - use when protected by external reverse proxy / auth)
STANDALONE_ALLOWED_NETWORK=127.0.0.1

# Direct ASP.NET Core environment variable overrides for multiple allowed networks:
# Admin__StandaloneAllowedNetworks__0=127.0.0.1
# Admin__StandaloneAllowedNetworks__1=::1
# Admin__StandaloneAllowedNetworks__2=10.0.0.0/8
# Admin__StandaloneAllowedNetworks__3=0.0.0.0/0

# ------------------------------------------------------------------------------
# 5. Enterprise Identity & Active Directory (Optional)
# ------------------------------------------------------------------------------
# Active Directory / Windows Auth Admin SID mapping (default: Local Administrators S-1-5-32-544)
# Admin__GroupSid=S-1-5-32-544
# Admin__GroupName=Domain Admins

# Reverse Proxy / OIDC forward-auth trusted proxies (comma-separated IPs/CIDRs)
# Oidc__TrustedProxies=127.0.0.1,10.0.0.0/8
# Oidc__RequireTrustedProxy=false

# ------------------------------------------------------------------------------
# 6. Secret Providers (Optional - HashiCorp Vault)
# ------------------------------------------------------------------------------
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=root-test-token
