<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      ASP.NET Core Module v2 (ANCM) Configuration for C# MCP Router Gateway
      =====================================================================
      Prerequisites:
        1. .NET 10.0 Windows Hosting Bundle or ASP.NET Core Module v2 installed on IIS.
        2. IIS Application Pool configured with .NET CLR Version: "No Managed Code".
        3. AppPool startMode set to "AlwaysRunning" to preserve MCP upstream connections.
    -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <!--
      CRITICAL ARCHITECTURAL SETTINGS:
      - hostingModel="inprocess": Runs ASP.NET Core within the IIS worker process (w3wp.exe) for maximum throughput.
      - responseBufferLimit="0": CRITICAL for Model Context Protocol (MCP) Server-Sent Events (SSE).
        Disables IIS response buffering so streaming chunks and SSE keepalive events flush immediately to LLM clients.
      - stdoutLogEnabled="false": Set to "true" to troubleshoot startup failures; logs output to .\logs\stdout.
    -->
    <aspNetCore processPath="dotnet"
                arguments=".\mcg.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <handlerSettings>
        <handlerSetting name="responseBufferLimit" value="0" />
      </handlerSettings>
      <environmentVariables>
        <!-- Core Hosting Configuration -->
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!--
          Database Provider Selection:
          Options: 'sqlite' (default), 'mssql', 'mysql', 'postgres'
        -->
        <environmentVariable name="DB_PROVIDER" value="sqlite" />

        <!--
          SQL Server Connection String Example:
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=127.0.0.1,14333;Database=mcp_router_test;User Id=sa;Password=McpRouterMSSQL2026!;TrustServerCertificate=True;Connect Timeout=30;" />
        -->

        <!--
          Router Master Symmetric Key (Minimum 32 characters for AES-256-GCM / HMAC):
          Uncomment to provide explicitly, or utilize DPAPI machine-encrypted keys in the Windows Registry.
          <environmentVariable name="ROUTER_SECRET" value="YOUR_SECURE_PRODUCTION_ROUTER_SECRET_KEY_32_CHARS_MIN" />
        -->

        <!--
          Vault Address and Token (Optional):
          <environmentVariable name="VAULT_ADDR" value="http://127.0.0.1:8200" />
          <environmentVariable name="VAULT_TOKEN" value="root-test-token" />
        -->
      </environmentVariables>
    </aspNetCore>

    <!--
      IIS Security & Authentication Configuration
      ===========================================
      Enables Integrated Windows Authentication (Negotiate / Kerberos / NTLM).
      Anonymous authentication is preserved to permit public token exchange and health probes.
    -->
    <security>
      <authentication>
        <windowsAuthentication enabled="true" />
        <anonymousAuthentication enabled="true" />
      </authentication>
      <requestFiltering>
        <!-- Request size limit (100MB max for large MCP tool payloads / batch embeddings) -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!--
      HTTP Protocol & Custom Security Headers
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <!--
      URL Compression Configuration:
      Static compression is enabled for frontend assets.
      Dynamic compression MUST be disabled or bypassed for SSE streaming endpoints (/sse, /message)
      to prevent IIS dynamic compression filters from buffering SSE frames.
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

  </system.webServer>
</configuration>
