    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../McpRouter.Tests/McpRouter.Tests.csproj" />
  </ItemGroup>
</Project>
